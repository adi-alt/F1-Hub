# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# python pipeline (pipeline/)
pipeline/.venv/
pipeline/f1_cache/
pipeline/__pycache__/

# typescript
*.tsbuildinfo
next-env.d.ts

# agent instructions (local only)
AGENTS.md
CLAUDE.md
pipeline/migration_data/
supabase/.temp/
.scratch_pw/

# Playwright
/test-results/
/playwright-report/
/e2e/.users.json

# Visual baselines are recorded on CI (Linux); local macOS runs write their own, which are not the baseline.
e2e/**/*-darwin.png
