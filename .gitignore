# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# python pipeline (pipeline/)
pipeline/.venv/
pipeline/f1_cache/
pipeline/__pycache__/

# typescript
*.tsbuildinfo
next-env.d.ts

# agent instructions (local only)
AGENTS.md
CLAUDE.md
pipeline/migration_data/
supabase/.temp/
.scratch_pw/

# Playwright
/test-results/
/playwright-report/
/e2e/.users.json

# Visual baselines are recorded on CI (Linux); local macOS runs write their own, which are not the baseline.
e2e/**/*-darwin.png

# docs/audit: the M0 audit. Only the design and UI documents are in the repo (it's public); these describe
# security findings, auth wiring or operational weaknesses, so they stay local.
docs/audit/README.md
docs/audit/ARCHITECTURE_MAP.md
docs/audit/AUDIT_COVERAGE.md
docs/audit/BACKEND_DATA_AND_SECURITY_AUDIT.md
docs/audit/DECISIONS_AND_OPEN_QUESTIONS.md
docs/audit/EXECUTIVE_SUMMARY.md
docs/audit/FEATURE_GAP_ANALYSIS.md
docs/audit/LLM_AI_AUDIT.md
docs/audit/M0_IMPLEMENTATION_STATUS.md
docs/audit/PERFORMANCE_TESTING_AND_OPERATIONS.md
docs/audit/PRIORITIZED_ROADMAP.md
docs/audit/RLS_LOCKDOWN_CHECKLIST.md
docs/audit/ROUTE_AND_COMPONENT_INVENTORY.md
docs/audit/UI_CRITIQUE_AND_REDESIGN.md
