# Every environment variable the app, scripts and pipeline read. Copy to .env.local and fill in what you
# need; never commit real values. README.md "Environment" says which are required where.

# ── App: Supabase (required) ─────────────────────────────────────────────────
# Project URL; also the one remotePatterns host for images (next.config.ts).
NEXT_PUBLIC_SUPABASE_URL=
# Publishable (anon) key: the browser client, used for identity only.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Secret (service-role) key: every server-side read and write (src/lib/supabase/admin.ts). Server only.
SUPABASE_SECRET_KEY=

# ── App: sessions and secrets (required) ─────────────────────────────────────
# Seals the f1hub_session cookie (iron-session, 32+ characters). Also keys AI telemetry user hashes and,
# if INVITE_TOKEN_SECRET is unset, community invite links.
SESSION_SECRET=
# Optional: signs community invite links separately from sessions (falls back to SESSION_SECRET).
INVITE_TOKEN_SECRET=
# Shared secret (sent as the x-cron-secret header) for automation: /api/admin/revalidate (pipeline) and /api/cron/emails (email-jobs.yml).
CRON_SECRET=
# Canonical site URL for links in emails, SEO and the pipeline's revalidation calls. Default https://apexf1hub.com.
APP_BASE_URL=
# Comma-separated emails that are site admins (bootstrap allow-list; /admin, race-photo review).
ADMIN_EMAILS=

# ── App: email (sign-in codes, invitations, notifications) ───────────────────
SMTP_HOST=
# Default 465.
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
# The From address.
MAIL_FROM=

# ── App: AI (optional: without keys every AI surface serves its deterministic fallback) ──
# Default Groq / OpenRouter accounts (compose assist, and any feature whose own key below is unset).
GROQ_API_KEY=
OPENROUTER_API_KEY=
# Per-feature accounts, so one feature's traffic can't exhaust another's quota.
GROQ_HOMEPAGE_API_KEY=
OPENROUTER_HOMEPAGE_API_KEY=
GROQ_RACE_INTELLIGENCE_API_KEY=
OPENROUTER_RACE_INTELLIGENCE_API_KEY=
GROQ_SEASON_INTELLIGENCE_API_KEY=
OPENROUTER_SEASON_INTELLIGENCE_API_KEY=
# Kill switch: 1/true/yes and no model is called anywhere.
AI_DISABLED=
# Requests per minute allowed to the provider per instance. Default 40.
AI_PROVIDER_RPM_LIMIT=

# ── App: other integrations (optional) ───────────────────────────────────────
# GIF search in the post composer (Klipy). Without it the GIF button is hidden.
KLIPY_API_KEY=
# PAT with actions:read/write on this repo: the admin Models page lists and triggers pipeline runs.
GITHUB_TOKEN=
# Sentry DSN for browser and server errors; also where CSP violation reports go. Unset = Sentry off.
NEXT_PUBLIC_SENTRY_DSN=
# 1 serves /dev/ui (the design-system preview) in a production build that isn't the production deployment.
UI_PREVIEW=

# ── Scripts and CI (not needed to run the app) ───────────────────────────────
# Postgres connection for migrations, schema fingerprint, backups and the restore drill.
DATABASE_URL=
# Refuse to run unless DATABASE_URL is this Supabase project ref.
EXPECTED_PROJECT_REF=
# Overrides DATABASE_URL for scripts/rls-snapshot.mjs.
RLS_SNAPSHOT_DATABASE_URL=
# A disposable Postgres server for the race-condition test suite (it creates and drops its own database).
TEST_DATABASE_URL=
# A disposable local Postgres for scripts/local-db/load.ts (browser tests, restore drill).
LOCAL_DATABASE_URL=
# The local Supabase stand-in's port (default 54321) and the PostgREST it proxies (default http://127.0.0.1:3000).
LOCAL_SUPABASE_PORT=
POSTGREST_URL=
# Browser tests: 1 = against the local database; port for next start (default 3100); allow a non-staging project.
E2E_LOCAL=
E2E_PORT=
E2E_ALLOW_OTHER_PROJECT=
# Staging tooling (scripts/staging/*), only while a staging project exists.
PRODUCTION_DATABASE_URL=
STAGING_DATABASE_URL=
STAGING_PROJECT_REF=
STAGING_SUPABASE_URL=
STAGING_SUPABASE_SECRET_KEY=
STAGING_SEED_PASSWORD=

# ── Pipeline (pipeline/, GitHub Actions) ─────────────────────────────────────
# Also reads DATABASE_URL, NEXT_PUBLIC_SUPABASE_URL, SUPABASE_SECRET_KEY (Storage uploads), CRON_SECRET and
# APP_BASE_URL (cache revalidation) from above.
# Pipeline failures go to Sentry when set.
SENTRY_DSN=
# Sentry environment name for the pipeline. Default "pipeline".
SENTRY_ENVIRONMENT=
# fetch_races.py: true = fetch every remaining round, not just the current one (manual catch-up).
FORCE_ALL_ROUNDS=
# race_photos.py: also write the candidates it found to this JSON file.
RACE_PHOTOS_JSON=
# weather_forecast.py: no forecast API is wired up yet; unused until one is.
WEATHER_API_KEY=
# Legacy Firestore credentials: only the one-off migration export (migrate_export.py) and old archive helpers.
FIREBASE_SERVICE_ACCOUNT_JSON=
